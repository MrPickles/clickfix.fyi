---
// A safe, in-page reenactment of a ClickFix lure.
// The only side effect is writing a harmless command to the clipboard after a click.
// That command contacts no server: it only prints a message.
---

<div class="demo" data-demo data-step="1">
  <div class="demo-grid">
    <div class="stage">
      <div class="fake-browser" aria-label="A fake website, part of the demo" role="group">
        <div class="fake-bar">
          <span class="fake-url">https://verify-human-check.example</span>
          <span class="fake-flag">Fake site</span>
        </div>

        <div class="fake-page">
          <div class="fake-panel" data-panel="check">
            <p class="fake-title">Checking that you’re human</p>
            <p class="fake-sub">This site needs to confirm you’re not a robot before you continue.</p>
            <button class="fake-check" type="button" data-check>
              <span class="fake-box" aria-hidden="true"></span>
              I’m not a robot
            </button>
          </div>

          <div class="fake-panel" data-panel="instructions" hidden>
            <p class="fake-title">One more step</p>
            <p class="fake-sub">Copy your verification code, then:</p>
            <div class="fake-code">
              <code>HUMAN-4821</code>
              <button class="fake-copy" type="button" data-copy>Copy</button>
            </div>
            <ol class="fake-steps">
              <li>Press <kbd>Win</kbd> + <kbd>X</kbd>, then <kbd>I</kbd></li>
              <li>Press <kbd>Ctrl</kbd> + <kbd>V</kbd></li>
              <li>Press <kbd>Enter</kbd></li>
            </ol>
          </div>
        </div>
      </div>

      <div class="practice" data-practice hidden>
        <p class="practice-label">Paste here, not in your real terminal. Nothing here can run.</p>

        <div class="term">
          <p class="term-title" aria-hidden="true">Windows PowerShell</p>
          <label class="term-body">
            <span class="term-prompt" aria-hidden="true">PS C:\Users\you&gt;</span>
            <textarea rows="3" spellcheck="false" autocomplete="off" data-paste aria-label="Practice terminal"></textarea>
          </label>
        </div>

        <button class="plain-button" type="button" data-fill hidden>Copy was blocked. Fill it in for me.</button>
      </div>

      <div class="reveal" data-reveal hidden aria-live="polite">
        <p class="reveal-label">What you actually copied:</p>
        <p class="clip" data-clip></p>
        <p class="reveal-label">Decoded, it says:</p>
        <p class="clip decoded" data-decoded></p>
        <p class="mismatch" data-mismatch hidden>That’s not what the demo copied; your clipboard held something else. Above is what it copied.</p>
      </div>
    </div>

    <div class="notes" aria-live="polite">
      <h3 data-note-title>The lure</h3>
      <div data-note-body></div>
      <button class="plain-button reset" type="button" data-reset hidden>Start the demo again</button>
    </div>
  </div>
</div>

<script>
  type Step = 1 | 2 | 3 | 4;

  const DECODED = "Write-Host 'clickfix.fyi: a web page just got you to run this. This one only prints text.'";
  // PowerShell's -EncodedCommand takes Base64 of UTF-16LE text, the same obfuscation real lures use.
  const ENCODED = btoa(Array.from(DECODED, (ch) => ch + "\0").join(""));
  const PROGRAM = "powershell -e ";
  const CLIPBOARD = PROGRAM + ENCODED;

  const notes: Record<Step, [string, string]> = {
    1: ["The lure", "<p>A fake check, like the ones planted on hacked sites. Click it.</p>"],
    2: ["The ask", "<p>The check “fails” and asks you to copy a code. Click Copy.</p>"],
    3: ["The switch", "<p>You didn’t copy <code>HUMAN-4821</code>. You copied a command. Paste it below to see.</p>"],
    4: [
      "The disguise",
      "<p>The command is scrambled so you can’t tell what it does. <kbd>Enter</kbd> would run it.</p><p>This one only prints a message. A real one downloads malware. On a Mac, the page sends you to Terminal instead.</p>",
    ],
  };

  const root = document.querySelector<HTMLElement>("[data-demo]");

  if (root) {
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const input = $<HTMLTextAreaElement>("[data-paste]");
    let copied = false;

    function setStep(step: Step) {
      root!.dataset.step = String(step);
      $("[data-panel=check]").hidden = step !== 1;
      $("[data-panel=instructions]").hidden = step === 1;
      $("[data-practice]").hidden = step < 3;
      $("[data-reveal]").hidden = step !== 4;
      $("[data-reset]").hidden = step === 1;
      $("[data-fill]").hidden = !(step === 3 && !copied);
      $("[data-copy]").textContent = step >= 3 ? "Copied" : "Copy";
      $("[data-note-title]").textContent = notes[step][0];
      $("[data-note-body]").innerHTML = notes[step][1];
    }

    function reset() {
      copied = false;
      input.value = "";
      setStep(1);
    }

    function showPasted(pasted: string | null) {
      const clip = $("[data-clip]");
      const program = document.createElement("span");
      program.className = "part-cmd";
      program.textContent = PROGRAM;
      const blob = document.createElement("span");
      blob.className = "part-blob";
      blob.textContent = ENCODED;
      clip.replaceChildren(program, blob);
      $("[data-decoded]").textContent = DECODED;
      $("[data-mismatch]").hidden = pasted === null || pasted.trim() === CLIPBOARD;
      setStep(4);
    }

    $("[data-check]").addEventListener("click", () => setStep(2));

    $("[data-copy]").addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(CLIPBOARD);
        copied = true;
      } catch {
        copied = false;
      }
      setStep(3);
    });

    input.addEventListener("paste", (event) => showPasted(event.clipboardData?.getData("text") ?? null));
    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        if (input.value) showPasted(input.value);
      }
    });

    $("[data-fill]").addEventListener("click", () => {
      input.value = CLIPBOARD;
      input.focus();
      showPasted(null);
    });

    $("[data-reset]").addEventListener("click", reset);
    setStep(1);
  }
</script>

<style>
  .demo {
    margin-top: 2rem;
  }

  .demo-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(16rem, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }

  /* ---------- Mock attacker UI (lure blue lives only here) ---------- */
  .fake-browser {
    overflow: hidden;
    border: 1px solid #c4c9cf;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 1px 0 #e3e6ea;
    font-family: var(--ui);
  }

  .fake-bar {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    border-bottom: 1px solid #dfe2e6;
    padding: 0.55rem 0.75rem;
    background: #eef0f3;
  }

  .fake-url {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
    background: #fff;
    color: #4a525c;
    font-size: 0.8rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .fake-flag {
    flex: none;
    border: 1px solid var(--stop);
    border-radius: 4px;
    padding: 0.05rem 0.4rem;
    color: var(--stop);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .fake-page {
    min-height: 17rem;
    display: grid;
    place-items: center;
    padding: clamp(1.25rem, 4vw, 2.5rem) 1.25rem;
    color: #2b3138;
  }

  .fake-panel {
    width: min(100%, 23rem);
  }

  .fake-title {
    font-size: 1.2rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .fake-sub {
    margin-top: 0.35rem;
    color: #5b636d;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .fake-check {
    width: 100%;
    display: flex;
    gap: 0.8rem;
    align-items: center;
    margin-top: 1.25rem;
    border: 1px solid #c9ced4;
    border-radius: 6px;
    padding: 1rem;
    background: #f9fafb;
    cursor: pointer;
    font-size: 1rem;
    text-align: left;
  }

  .fake-check:hover {
    border-color: var(--lure);
  }

  .fake-box {
    width: 1.6rem;
    height: 1.6rem;
    flex: none;
    border: 2px solid #8b939c;
    border-radius: 4px;
    background: #fff;
  }

  .fake-code {
    display: flex;
    align-items: stretch;
    margin-top: 1rem;
    border: 1px solid #c9ced4;
    border-radius: 6px;
    overflow: hidden;
  }

  .fake-code code {
    flex: 1;
    padding: 0.65rem 0.8rem;
    background: #f9fafb;
    font-size: 1rem;
    letter-spacing: 0.04em;
  }

  .fake-copy {
    border: 0;
    padding: 0 1.1rem;
    background: var(--lure);
    color: #fff;
    cursor: pointer;
    font-family: var(--ui);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .fake-copy:hover {
    background: #1d4fa3;
  }

  .fake-steps {
    display: grid;
    gap: 0.6rem;
    margin-top: 1rem;
    border-left: 3px solid var(--lure);
    padding-left: 1.75rem;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .fake-steps kbd {
    font-family: var(--ui);
  }

  /* ---------- Practice box ---------- */
  .practice {
    margin-top: 1.5rem;
  }

  .practice-label {
    max-width: 34rem;
    margin-bottom: 0.75rem;
    font-size: 1rem;
  }

  .term {
    max-width: 36rem;
    overflow: hidden;
    border-radius: 8px;
    background: #0c1a2b;
    color: #e6e9ec;
  }

  .term-title {
    padding: 0.4rem 0.8rem;
    background: #1f2b3a;
    color: #b8c2cc;
    font: 0.78rem var(--ui);
  }

  .term-body {
    display: block;
    padding: 0.8rem 0.9rem;
    font: 0.88rem/1.5 var(--mono);
  }

  .term-prompt {
    display: block;
    color: #e6e9ec;
  }

  .term-body textarea {
    width: 100%;
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    field-sizing: content;
    word-break: break-all;
    resize: none;
    caret-color: #e6e9ec;
  }

  .term-body textarea:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }

  .plain-button {
    margin-top: 0.85rem;
    border: 0;
    padding: 0;
    background: none;
    cursor: pointer;
    font-family: var(--ui);
    font-size: 0.95rem;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  /* ---------- Reveal ---------- */
  .reveal {
    margin-top: 1.75rem;
  }

  .reveal-label {
    margin-bottom: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .clip {
    border-radius: 8px;
    padding: 1rem;
    background: var(--wash);
    font: 0.85rem/1.7 var(--mono);
    overflow-wrap: anywhere;
  }

  .clip :global(.part-cmd) {
    background: var(--stop-wash);
    box-shadow: inset 0 -2px 0 var(--stop);
    color: var(--stop-deep);
  }

  .clip :global(.part-blob) {
    color: var(--muted);
    word-break: break-all;
  }

  .decoded {
    color: var(--ink);
  }

  .reveal .reveal-label + .decoded {
    margin-top: 0;
  }

  .clip + .reveal-label {
    margin-top: 1.25rem;
  }

  .mismatch {
    margin-top: 0.75rem;
    color: var(--stop-deep);
    font-size: 0.95rem;
  }

  /* ---------- Notes ---------- */
  .notes {
    position: sticky;
    top: 1.5rem;
    border-top: 3px solid var(--ink);
    padding-top: 1rem;
  }

  .notes h3 {
    margin-bottom: 0.6rem;
  }

  .notes :global(p) {
    font-size: 1.05rem;
  }

  .notes :global(p + p) {
    margin-top: 0.75rem;
  }

  .reset {
    margin-top: 1.25rem;
  }

  @media (max-width: 52rem) {
    .demo-grid {
      grid-template-columns: 1fr;
    }

    .notes {
      position: static;
    }
  }
</style>
