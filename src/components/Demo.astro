---
// A safe, in-page reenactment of a ClickFix lure.
// The only side effect is writing a harmless command to the clipboard after a click.
// That command contacts no server: it only prints a message.
---

<div class="demo" data-demo data-os="windows" data-step="1">
  <fieldset class="os-picker">
    <legend>Show the version for</legend>
    <label><input type="radio" name="demo-os" value="windows" checked /> Windows</label>
    <label><input type="radio" name="demo-os" value="macos" /> Mac</label>
    <label><input type="radio" name="demo-os" value="linux" /> Linux</label>
  </fieldset>

  <div class="demo-grid">
    <div class="stage">
      <div class="fake-browser" aria-label="A fake website, part of the demo" role="group">
        <div class="fake-bar">
          <span class="fake-url">https://verify-human-check.example</span>
          <span class="fake-flag">Fake site</span>
        </div>

        <div class="fake-page">
          <div class="fake-panel" data-panel="check">
            <p class="fake-title">Checking that you’re human</p>
            <p class="fake-sub">This site needs to confirm you’re not a robot before you continue.</p>
            <button class="fake-check" type="button" data-check>
              <span class="fake-box" aria-hidden="true"></span>
              I’m not a robot
            </button>
          </div>

          <div class="fake-panel" data-panel="instructions" hidden>
            <p class="fake-title">One more step</p>
            <p class="fake-sub">Copy your verification code, then:</p>
            <div class="fake-code">
              <code>HUMAN-4821</code>
              <button class="fake-copy" type="button" data-copy>Copy</button>
            </div>
            <ol class="fake-steps" data-for="windows">
              <li>Press <kbd>Win</kbd> + <kbd>R</kbd></li>
              <li>Press <kbd>Ctrl</kbd> + <kbd>V</kbd></li>
              <li>Press <kbd>Enter</kbd></li>
            </ol>
            <ol class="fake-steps" data-for="macos">
              <li>Press <kbd>⌘</kbd> + <kbd>Space</kbd>, type <b>Terminal</b>, press <kbd>Return</kbd></li>
              <li>Press <kbd>⌘</kbd> + <kbd>V</kbd></li>
              <li>Press <kbd>Return</kbd></li>
            </ol>
            <ol class="fake-steps" data-for="linux">
              <li>Press <kbd>Ctrl</kbd> + <kbd>Alt</kbd> + <kbd>T</kbd></li>
              <li>Press <kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>V</kbd></li>
              <li>Press <kbd>Enter</kbd></li>
            </ol>
          </div>
        </div>
      </div>

      <div class="practice" data-practice hidden>
        <p class="practice-label">
          Paste here, not in your real <span data-tool-name>Run box</span>. Nothing here can run.
        </p>

        <div class="run-dialog" data-for="windows">
          <p class="run-title">Run</p>
          <p class="run-help">Type the name of a program, folder, document, or Internet resource, and Windows will open it for you.</p>
          <label class="run-row">
            <span>Open:</span>
            <input type="text" spellcheck="false" autocomplete="off" data-paste aria-label="Practice Run box" />
          </label>
        </div>

        <div class="term" data-for="macos linux">
          <label class="term-row">
            <span class="term-prompt" aria-hidden="true" data-prompt>%</span>
            <input type="text" spellcheck="false" autocomplete="off" data-paste aria-label="Practice terminal" />
          </label>
        </div>

        <button class="plain-button" type="button" data-fill hidden>Copy was blocked. Fill it in for me.</button>
      </div>

      <div class="reveal" data-reveal hidden aria-live="polite">
        <p class="reveal-label">What you actually copied:</p>
        <p class="clip" data-clip></p>
        <dl class="parts" data-parts></dl>
      </div>
    </div>

    <div class="notes" aria-live="polite">
      <h3 data-note-title>The lure</h3>
      <div data-note-body></div>
      <button class="plain-button reset" type="button" data-reset hidden>Start the demo again</button>
    </div>
  </div>
</div>

<script>
  type OS = "windows" | "macos" | "linux";
  type Step = 1 | 2 | 3 | 4;

  const MESSAGE = "clickfix.fyi: a web page just got you to run this. This one only prints text.";
  const DECOY = "✅ I am not a robot - Verification ID: 4821";
  const PADDING = 60;

  const payloads: Record<OS, { command: string; padding: number; decoy: string }> = {
    windows: {
      command: `powershell -NoExit -Command "Write-Host '${MESSAGE}'"`,
      padding: PADDING,
      decoy: `# ${DECOY}`,
    },
    macos: { command: `echo "${MESSAGE}"`, padding: 0, decoy: "" },
    linux: { command: `echo "${MESSAGE}"`, padding: 0, decoy: "" },
  };

  const toolName: Record<OS, string> = { windows: "Run box", macos: "Terminal", linux: "terminal" };

  const common: Record<1 | 2, [string, string]> = {
    1: ["The lure", "<p>A fake check, like the ones planted on hacked sites. Click it.</p>"],
    2: ["The ask", "<p>The check “fails” and asks you to copy a code. Click Copy.</p>"],
  };

  const later: Record<OS, Record<3 | 4, [string, string]>> = {
    windows: {
      3: ["The switch", "<p>You didn’t copy <code>HUMAN-4821</code>. You copied a command. Paste it below to see.</p>"],
      4: ["The disguise", "<p>The Run box shows only the decoy at the end. <kbd>Enter</kbd> would run everything in front of it.</p><p>Ran it for real? It only printed a message.</p>"],
    },
    macos: {
      3: ["The switch", "<p>You didn’t copy <code>HUMAN-4821</code>. You copied a command. Paste it below to see.</p>"],
      4: ["The disguise", "<p>Terminal shows the whole command, so real ones are scrambled to look like gibberish.</p><p>Ran it for real? It only printed a message.</p>"],
    },
    linux: {
      3: ["The switch", "<p>You didn’t copy <code>HUMAN-4821</code>. You copied a command. Paste it below to see.</p>"],
      4: ["The disguise", "<p>A terminal shows the whole command, so real ones are scrambled to look like gibberish.</p><p>Ran it for real? It only printed a message.</p>"],
    },
  };

  const root = document.querySelector<HTMLElement>("[data-demo]");

  if (root) {
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const $$ = <T extends Element = HTMLElement>(s: string) => Array.from(root.querySelectorAll<T>(s));

    let os: OS = detectOS();
    let copied = false;

    function detectOS(): OS {
      const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
      const hint = `${nav.userAgentData?.platform ?? ""} ${navigator.platform ?? ""} ${navigator.userAgent}`.toLowerCase();
      if (hint.includes("mac") || hint.includes("iphone") || hint.includes("ipad")) return "macos";
      if (hint.includes("linux") && !hint.includes("android")) return "linux";
      return "windows";
    }

    function clipboardText(target: OS = os) {
      const p = payloads[target];
      return p.padding ? `${p.command}${" ".repeat(p.padding)}${p.decoy}` : p.command;
    }

    function setStep(step: Step) {
      root!.dataset.step = String(step);
      $("[data-panel=check]").hidden = step !== 1;
      $("[data-panel=instructions]").hidden = step === 1;
      $("[data-practice]").hidden = step < 3;
      $("[data-reveal]").hidden = step !== 4;
      $("[data-reset]").hidden = step === 1;
      $("[data-fill]").hidden = !(step === 3 && !copied);
      const copy = $<HTMLButtonElement>("[data-copy]");
      copy.textContent = step >= 3 ? "Copied" : "Copy";
      const [title, body] = step <= 2 ? common[step as 1 | 2] : later[os][step as 3 | 4];
      $("[data-note-title]").textContent = title;
      $("[data-note-body]").innerHTML = body;
    }

    function setOS(next: OS) {
      os = next;
      root!.dataset.os = next;
      $$<HTMLInputElement>("input[name=demo-os]").forEach((r) => (r.checked = r.value === next));
      $$("[data-for]").forEach((el) => (el.hidden = !el.dataset.for!.split(" ").includes(next)));
      $("[data-tool-name]").textContent = toolName[next];
      $("[data-prompt]").textContent = next === "macos" ? "%" : "$";
      reset();
    }

    function reset() {
      copied = false;
      $$<HTMLInputElement>("[data-paste]").forEach((i) => (i.value = ""));
      setStep(1);
    }

    function renderReveal(pasted: string | null) {
      const p = payloads[os];
      const clip = $("[data-clip]");
      clip.replaceChildren();
      const add = (cls: string, text: string) => {
        const span = document.createElement("span");
        span.className = cls;
        span.textContent = text;
        clip.append(span);
      };
      add("part-cmd", p.command);
      if (p.padding) {
        add("part-pad", "·".repeat(p.padding));
        add("part-decoy", p.decoy);
      }

      const parts: [string, string][] = [["part-cmd", "The command that runs"]];
      if (p.padding) {
        parts.push(["part-pad", `${p.padding} spaces to push it out of view`]);
        parts.push(["part-decoy", "The decoy you see"]);
      }
      const dl = $("[data-parts]");
      dl.replaceChildren();
      for (const [cls, label] of parts) {
        const dt = document.createElement("dt");
        dt.className = cls;
        dt.setAttribute("aria-hidden", "true");
        const dd = document.createElement("dd");
        dd.textContent = label;
        dl.append(dt, dd);
      }
      if (pasted !== null && pasted.trim() !== clipboardText().trim()) {
        const dd = document.createElement("dd");
        dd.className = "mismatch";
        dd.textContent = "That’s not what the demo copied; your clipboard held something else. Above is what it copied.";
        dl.append(dd);
      }
    }

    function showPasted(input: HTMLInputElement, pasted: string | null) {
      requestAnimationFrame(() => {
        input.scrollLeft = input.scrollWidth;
        renderReveal(pasted);
        setStep(4);
      });
    }

    $("[data-check]").addEventListener("click", () => setStep(2));

    $("[data-copy]").addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(clipboardText());
        copied = true;
      } catch {
        copied = false;
      }
      setStep(3);
    });

    $$<HTMLInputElement>("[data-paste]").forEach((input) => {
      input.addEventListener("paste", (event) => {
        const text = event.clipboardData?.getData("text") ?? null;
        showPasted(input, text);
      });
      input.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
          event.preventDefault();
          if (input.value) showPasted(input, input.value);
        }
      });
    });

    $("[data-fill]").addEventListener("click", () => {
      const input = $$<HTMLInputElement>("[data-paste]").find((i) => !i.closest("[hidden]"))!;
      input.value = clipboardText();
      input.focus();
      showPasted(input, null);
    });

    $("[data-reset]").addEventListener("click", reset);
    $$<HTMLInputElement>("input[name=demo-os]").forEach((r) =>
      r.addEventListener("change", () => setOS(r.value as OS)),
    );

    setOS(os);
  }
</script>

<style>
  .demo {
    margin-top: 2rem;
  }

  .os-picker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0 0 1rem;
    border: 0;
    padding: 0;
    font-family: var(--ui);
    font-size: 0.9rem;
  }

  .os-picker legend {
    float: left;
    margin-right: 0.5rem;
    padding: 0;
    color: var(--muted);
  }

  .os-picker label {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    cursor: pointer;
  }

  .os-picker input {
    accent-color: var(--ink);
  }

  .demo-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(16rem, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }

  /* ---------- Mock attacker UI (lure blue lives only here) ---------- */
  .fake-browser {
    overflow: hidden;
    border: 1px solid #c4c9cf;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 1px 0 #e3e6ea;
    font-family: var(--ui);
  }

  .fake-bar {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    border-bottom: 1px solid #dfe2e6;
    padding: 0.55rem 0.75rem;
    background: #eef0f3;
  }

  .fake-url {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
    background: #fff;
    color: #4a525c;
    font-size: 0.8rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .fake-flag {
    flex: none;
    border: 1px solid var(--stop);
    border-radius: 4px;
    padding: 0.05rem 0.4rem;
    color: var(--stop);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .fake-page {
    min-height: 17rem;
    display: grid;
    place-items: center;
    padding: clamp(1.25rem, 4vw, 2.5rem) 1.25rem;
    color: #2b3138;
  }

  .fake-panel {
    width: min(100%, 23rem);
  }

  .fake-title {
    font-size: 1.2rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .fake-sub {
    margin-top: 0.35rem;
    color: #5b636d;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .fake-check {
    width: 100%;
    display: flex;
    gap: 0.8rem;
    align-items: center;
    margin-top: 1.25rem;
    border: 1px solid #c9ced4;
    border-radius: 6px;
    padding: 1rem;
    background: #f9fafb;
    cursor: pointer;
    font-size: 1rem;
    text-align: left;
  }

  .fake-check:hover {
    border-color: var(--lure);
  }

  .fake-box {
    width: 1.6rem;
    height: 1.6rem;
    flex: none;
    border: 2px solid #8b939c;
    border-radius: 4px;
    background: #fff;
  }

  .fake-code {
    display: flex;
    align-items: stretch;
    margin-top: 1rem;
    border: 1px solid #c9ced4;
    border-radius: 6px;
    overflow: hidden;
  }

  .fake-code code {
    flex: 1;
    padding: 0.65rem 0.8rem;
    background: #f9fafb;
    font-size: 1rem;
    letter-spacing: 0.04em;
  }

  .fake-copy {
    border: 0;
    padding: 0 1.1rem;
    background: var(--lure);
    color: #fff;
    cursor: pointer;
    font-family: var(--ui);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .fake-copy:hover {
    background: #1d4fa3;
  }

  .fake-steps {
    display: grid;
    gap: 0.6rem;
    margin-top: 1rem;
    border-left: 3px solid var(--lure);
    padding-left: 1.75rem;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .fake-steps kbd {
    font-family: var(--ui);
  }

  /* ---------- Practice box ---------- */
  .practice {
    margin-top: 1.5rem;
  }

  .practice-label {
    max-width: 34rem;
    margin-bottom: 0.75rem;
    font-size: 1rem;
  }

  .run-dialog {
    max-width: 26rem;
    border: 1px solid #b8bec5;
    border-radius: 8px;
    padding: 0.9rem 1rem 1.1rem;
    background: #f7f8fa;
    font-family: var(--ui);
    font-size: 0.85rem;
  }

  .run-title {
    font-weight: 600;
  }

  .run-help {
    margin: 0.5rem 0 0.8rem;
    color: #4a525c;
    line-height: 1.4;
  }

  .run-row {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }

  .run-row input {
    flex: 1;
    min-width: 0;
    border: 1px solid #8b939c;
    border-radius: 3px;
    padding: 0.35rem 0.45rem;
    background: #fff;
    font: 0.9rem var(--ui);
  }

  .term {
    max-width: 34rem;
    border-radius: 8px;
    padding: 0.9rem 1rem;
    background: #1d2126;
    color: #e6e9ec;
  }

  .term-row {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    font: 0.9rem var(--mono);
  }

  .term-prompt {
    color: #8fd3a8;
  }

  .term-row input {
    flex: 1;
    min-width: 0;
    border: 0;
    padding: 0.2rem 0;
    background: transparent;
    color: inherit;
    font: inherit;
    caret-color: #e6e9ec;
  }

  .term-row input:focus-visible {
    outline-offset: 6px;
  }

  .plain-button {
    margin-top: 0.85rem;
    border: 0;
    padding: 0;
    background: none;
    cursor: pointer;
    font-family: var(--ui);
    font-size: 0.95rem;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  /* ---------- Reveal ---------- */
  .reveal {
    margin-top: 1.75rem;
  }

  .reveal-label {
    margin-bottom: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .clip {
    border-radius: 8px;
    padding: 1rem;
    background: var(--wash);
    font: 0.85rem/1.7 var(--mono);
    overflow-wrap: anywhere;
  }

  .clip :global(.part-cmd) {
    background: var(--stop-wash);
    box-shadow: inset 0 -2px 0 var(--stop);
    color: var(--stop-deep);
  }

  .clip :global(.part-pad) {
    color: #a3aab2;
    letter-spacing: -0.12em;
  }

  .clip :global(.part-decoy) {
    color: var(--muted);
  }

  .parts {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.45rem 0.75rem;
    margin: 1rem 0 0;
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .parts :global(dt) {
    width: 1.5rem;
    height: 0.9rem;
    margin-top: 0.25rem;
    border-radius: 2px;
  }

  .parts :global(dt.part-cmd) {
    background: var(--stop-wash);
  }

  .parts :global(dt.part-pad) {
    background: repeating-linear-gradient(90deg, #a3aab2 0 2px, transparent 2px 5px);
    background-size: 100% 2px;
    background-position: center;
    background-repeat: no-repeat;
  }

  .parts :global(dt.part-decoy) {
    background: var(--wash);
    box-shadow: inset 0 0 0 1px var(--rule);
  }

  .parts :global(dd) {
    margin: 0;
  }

  .parts :global(.mismatch) {
    grid-column: 1 / -1;
    margin-top: 0.5rem;
    color: var(--stop-deep);
  }

  /* ---------- Notes ---------- */
  .notes {
    position: sticky;
    top: 1.5rem;
    border-top: 3px solid var(--ink);
    padding-top: 1rem;
  }

  .notes h3 {
    margin-bottom: 0.6rem;
  }

  .notes :global(p) {
    font-size: 1.05rem;
  }

  .notes :global(p + p) {
    margin-top: 0.75rem;
  }

  .reset {
    margin-top: 1.25rem;
  }

  @media (max-width: 52rem) {
    .demo-grid {
      grid-template-columns: 1fr;
    }

    .notes {
      position: static;
    }
  }
</style>
