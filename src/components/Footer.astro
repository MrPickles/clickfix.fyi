---
interface Props {
  reviewed: string;
}
const { reviewed } = Astro.props;
---

<footer class="site-footer">
  <div class="wrap">
    <p class="measure">
      clickfix.fyi explains one scam so people can recognize it. It has no ads, analytics, accounts or cookies.
      The demo only puts harmless text on your clipboard.
    </p>
    <p class="meta">Last reviewed {reviewed}.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(4rem, 10vw, 7rem);
    border-top: 1px solid var(--rule);
    padding-block: 2.5rem 3rem;
    color: var(--muted);
    font-size: 1rem;
  }

  .meta {
    margin-top: 0.75rem;
    font-family: var(--ui);
    font-size: 0.875rem;
  }
</style>
