---
const links = [
  { href: "#demo", label: "Demo" },
  { href: "#ran-it", label: "Ran a command?" },
  { href: "#for-it", label: "For IT teams" },
  { href: "#reading", label: "Sources" },
];
---

<header class="site-header wrap">
  <a class="brand" href="/">clickfix.fyi</a>
  <nav aria-label="Sections">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.25rem;
    font-family: var(--ui);
    font-size: 0.95rem;
  }

  .brand {
    font-family: var(--mono);
    font-weight: 600;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.4rem;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
