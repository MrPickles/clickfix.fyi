---
const resources = [
  {
    date: "Aug 2025",
    title: "Think before you Click(Fix): analyzing the ClickFix social engineering technique",
    source: "Microsoft Threat Intelligence",
    url: "https://www.microsoft.com/en-us/security/blog/2025/08/21/think-before-you-clickfix-analyzing-the-clickfix-social-engineering-technique/",
  },
  {
    date: "Jul 2025",
    title: "FileFix: the new social engineering attack building on ClickFix",
    source: "Check Point Research",
    url: "https://blog.checkpoint.com/research/filefix-the-new-social-engineering-attack-building-on-clickfix-tested-in-the-wild/",
  },
  {
    date: "Jun 2025",
    title: "ESET Threat Report H1 2025",
    source: "ESET Research",
    url: "https://www.welivesecurity.com/en/eset-research/eset-threat-report-h1-2025/",
  },
  {
    date: "May 2025",
    title: "Behavior:Win32/ClickFix",
    source: "Microsoft Security Intelligence",
    url: "https://www.microsoft.com/en-us/wdsi/threats/malware-encyclopedia-description?Name=Behavior%3AWin32%2FClickFix",
  },
  {
    date: "Nov 2024",
    title: "Security brief: ClickFix social engineering technique floods threat landscape",
    source: "Proofpoint Threat Research",
    url: "https://www.proofpoint.com/us/blog/threat-insight/security-brief-clickfix-social-engineering-technique-floods-threat-landscape",
  },
  {
    date: "Oct 2024",
    title: "ClickFix attacks: health sector alert",
    source: "U.S. HHS HC3",
    url: "https://www.hhs.gov/sites/default/files/clickfix-attacks-sector-alert-tlpclear.pdf",
  },
];
---

<ul class="resource-list">
  {resources.map((item) => (
    <li class="resource-item">
      <time>{item.date}</time>
      <div>
        <a class="resource-title" href={item.url} target="_blank" rel="noopener noreferrer">{item.title}</a>
        <span>{item.source}</span>
      </div>
    </li>
  ))}
</ul>

<style>
  .resource-list {
    margin-top: 1.5rem;
    border-top: 1px solid var(--line);
    padding: 0;
    list-style: none;
  }

  .resource-item {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding-block: 1rem;
  }

  .resource-item time,
  .resource-item span {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .resource-item > div {
    display: grid;
    gap: 0.25rem;
  }

  .resource-title {
    font-size: 1.08rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.3;
    text-decoration: none;
  }

  .resource-title:hover { color: var(--signal); }

  @media (max-width: 520px) {
    .resource-item { grid-template-columns: 1fr; gap: 0.3rem; }
  }
</style>
