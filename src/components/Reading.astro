---
type Item = { date: string; source: string; title: string; url: string };

const groups: { heading: string; items: Item[] }[] = [
  {
    heading: "Start here",
    items: [
      {
        date: "Aug 2025",
        source: "Microsoft Threat Intelligence",
        title: "Think before you Click(Fix): analyzing the ClickFix social engineering technique",
        url: "https://www.microsoft.com/en-us/security/blog/2025/08/21/think-before-you-clickfix-analyzing-the-clickfix-social-engineering-technique/",
      },
      {
        date: "Nov 2024",
        source: "Proofpoint",
        title: "Security brief: ClickFix social engineering technique floods threat landscape",
        url: "https://www.proofpoint.com/us/blog/threat-insight/security-brief-clickfix-social-engineering-technique-floods-threat-landscape",
      },
    ],
  },
  {
    heading: "Variants",
    items: [
      {
        date: "Oct 2026",
        source: "iTnews, on Microsoft Threat Intelligence findings",
        title: "Microsoft spots new twist on ClickFix “cache smuggling”",
        url: "https://www.itnews.com.au/news/microsoft-spots-new-twist-on-clickfix-cache-smuggling-629401",
      },
      {
        date: "Mar 2026",
        source: "SecurityWeek, on Microsoft Threat Intelligence findings",
        title: "ClickFix attack uses Windows Terminal to evade detection",
        url: "https://www.securityweek.com/clickfix-attack-uses-windows-terminal-to-evade-detection/",
      },
      {
        date: "Feb 2026",
        source: "Microsoft Defender Security Research",
        title: "New ClickFix variant ‘CrashFix’ deploying Python remote access trojan",
        url: "https://www.microsoft.com/en-us/security/blog/2026/02/05/clickfix-variant-crashfix-deploying-python-rat-trojan/",
      },
      {
        date: "Dec 2025",
        source: "Push Security",
        title: "ConsentFix debrief",
        url: "https://pushsecurity.com/blog/consentfix-debrief",
      },
      {
        date: "Jun 2025",
        source: "Kaspersky",
        title: "FileFix: a new ClickFix variation",
        url: "https://www.kaspersky.com/blog/filefix-attack-windows-file-explorer/54752/",
      },
      {
        date: "Apr 2025",
        source: "Proofpoint",
        title: "Around the world in 90 days: state-sponsored actors try ClickFix",
        url: "https://www.proofpoint.com/us/blog/threat-insight/around-world-90-days-state-sponsored-actors-try-clickfix",
      },
    ],
  },
  {
    heading: "Defenses",
    items: [
      {
        date: "Jun 2026",
        source: "MacRumors, on Apple’s support document",
        title: "Apple details Terminal anti-scam warning in macOS",
        url: "https://www.macrumors.com/2026/06/16/apple-details-terminal-anti-scam-warning-in-macos/",
      },
      {
        date: "Ongoing",
        source: "Microsoft Security Intelligence",
        title: "Behavior:Win32/ClickFix threat description",
        url: "https://www.microsoft.com/en-us/wdsi/threats/malware-encyclopedia-description?Name=Behavior%3AWin32%2FClickFix",
      },
    ],
  },
];
---

<div class="reading">
  {groups.map((group) => (
    <section>
      <h3>{group.heading}</h3>
      <ul>
        {group.items.map((item) => (
          <li>
            <a href={item.url} rel="noopener noreferrer">{item.title}</a>
            <span class="meta">{item.source}, {item.date}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .reading {
    display: grid;
    gap: 2.25rem;
    margin-top: 2rem;
  }

  h3 {
    margin-bottom: 0.25rem;
  }

  ul {
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    gap: 0.1rem;
    border-bottom: 1px solid var(--rule);
    padding-block: 0.85rem;
  }

  a {
    font-weight: 560;
    line-height: 1.35;
  }

  .meta {
    color: var(--muted);
    font-family: var(--ui);
    font-size: 0.875rem;
  }
</style>
